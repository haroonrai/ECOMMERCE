# ============================================================
# AETHEL & CO. / AURA HEALTHCARE E-COMMERCE ENVIRONMENT CONFIG
# ============================================================

# Flask Secret Key for session signing (Set a random 32+ character string in production)
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production_99812

# Environment Mode ('production' or 'development')
FLASK_ENV=production

# Server Port (Default is 5000; Cloud hosts like Render/Railway set this automatically)
PORT=5000

# Custom Database Location (Optional: useful for cloud persistent disks e.g. /var/data/ecommerce.db)
DATABASE_PATH=ecommerce.db

# Force seed database on startup (Set to 'true' only if you want to wipe and re-seed sample data)
FORCE_SEED=false
